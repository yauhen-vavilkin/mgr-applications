{
  "moduleDefaults": {
    "resources": {
      "requests": { "cpu": "128m", "memory": "900Mi" },
      "limits": { "cpu": "512m", "memory": "1Gi" }
    },
    "java": {
      "options": "-XX:MaxRAMPercentage=66.0 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp"
    },
    "deployment": {
      "replicas": 1,
      "port": 8081,
      "livenessProbe": "/admin/health/liveness",
      "readinessProbe": "/admin/health/readiness"
    },
    "kong": { "enabled": true },
    "EnvVars": [
      {"name": "DB_HOST", "value": "postgres", "description": "Postgres hostname", "type": "string", "essential": true},
      {"name": "DB_PORT", "value": "5432", "description": "Postgres port", "type": "number", "essential": true},
      {"name": "DB_USERNAME", "value": "postgres", "description": "Postgres username", "type": "string", "essential": true},
      {"name": "DB_PASSWORD", "value": "postgres", "description": "Postgres user password", "type": "secret", "essential": true},
      {"name": "DB_DATABASE", "value": "okapi_modules", "description": "Postgres database name", "type": "string", "essential": true},
      {"name": "ENV", "value": "folio", "description": "Logical deployment name (Kafka topic prefix); unique per shared Kafka cluster", "type": "string", "essential": true},
      {"name": "KAFKA_HOST", "value": "kafka", "description": "Kafka broker hostname", "type": "string", "essential": true},
      {"name": "KAFKA_PORT", "value": "9092", "description": "Kafka broker port", "type": "number", "essential": true},
      {"name": "KAFKA_SECURITY_PROTOCOL", "value": "PLAINTEXT", "description": "Kafka security protocol", "type": "string", "essential": false},
      {"name": "KAFKA_SSL_KEYSTORE_LOCATION", "value": "", "description": "Kafka SSL keystore location", "type": "string", "essential": false},
      {"name": "KAFKA_SSL_KEYSTORE_PASSWORD", "value": "", "description": "Kafka SSL keystore password", "type": "secret", "essential": false},
      {"name": "KAFKA_SSL_TRUSTSTORE_LOCATION", "value": "", "description": "Kafka SSL truststore location", "type": "string", "essential": false},
      {"name": "KAFKA_SSL_TRUSTSTORE_PASSWORD", "value": "", "description": "Kafka SSL truststore password", "type": "secret", "essential": false},
      {"name": "KAFKA_DISCOVERY_TOPIC_PARTITIONS", "value": "1", "description": "Number of partitions of the discovery topic", "type": "number", "essential": false},
      {"name": "KAFKA_DISCOVERY_TOPIC_REPLICATION_FACTOR", "value": "", "description": "Replication factor of the discovery topic", "type": "number", "essential": false},
      {"name": "FAR_MODE", "value": "false", "description": "Enables FAR mode (descriptor CRUD only)", "type": "boolean", "essential": false},
      {"name": "VALIDATION_MODE", "value": "basic", "description": "Default descriptor validation mode: none, basic, on_create", "type": "string", "essential": false},
      {"name": "SECURITY_ENABLED", "value": "true", "description": "Enables security", "type": "boolean", "essential": false},
      {"name": "ROUTER_PATH_PREFIX", "value": "", "description": "Router path prefix", "type": "string", "essential": false},
      {"name": "SERVER_PORT", "value": "8081", "description": "HTTP server port", "type": "number", "essential": false},
      {"name": "MODULE_URL", "value": "http://mgr-applications:8081", "description": "Module URL used for API gateway self-registration", "type": "string", "essential": true},
      {"name": "APIGW_ENABLED", "value": "true", "description": "Enables API gateway integration", "type": "boolean", "essential": false},
      {"name": "APIGW_TYPE", "value": "kong", "description": "API gateway implementation: kong or apisix", "type": "string", "essential": false},
      {"name": "APIGW_URL", "value": "", "description": "API gateway Admin URL", "type": "string", "essential": true},
      {"name": "APIGW_API_KEY", "value": "", "description": "APISIX Admin API key (required when APIGW_TYPE=apisix)", "type": "secret", "essential": false},
      {"name": "APIGW_REGISTER_MODULE", "value": "true", "description": "Register module in the API gateway at startup", "type": "boolean", "essential": false},
      {"name": "APIGW_CONNECT_TIMEOUT", "value": "", "description": "Gateway to upstream connect timeout in ms", "type": "number", "essential": false},
      {"name": "APIGW_READ_TIMEOUT", "value": "", "description": "Gateway to upstream read timeout in ms", "type": "number", "essential": false},
      {"name": "APIGW_WRITE_TIMEOUT", "value": "", "description": "Gateway to upstream write timeout in ms", "type": "number", "essential": false},
      {"name": "APIGW_RETRIES", "value": "", "description": "Gateway proxy retries", "type": "number", "essential": false},
      {"name": "APIGW_TLS_ENABLED", "value": "false", "description": "Enables TLS to the API gateway", "type": "boolean", "essential": false},
      {"name": "APIGW_TLS_TRUSTSTORE_PATH", "value": "", "description": "API gateway TLS truststore path", "type": "string", "essential": false},
      {"name": "APIGW_TLS_TRUSTSTORE_PASSWORD", "value": "", "description": "API gateway TLS truststore password", "type": "secret", "essential": false},
      {"name": "APIGW_TLS_TRUSTSTORE_TYPE", "value": "", "description": "API gateway TLS truststore type", "type": "string", "essential": false},
      {"name": "KC_INTEGRATION_ENABLED", "value": "true", "description": "Enables Keycloak integration", "type": "boolean", "essential": false},
      {"name": "KC_URL", "value": "http://keycloak:8080", "description": "Keycloak URL", "type": "string", "essential": true},
      {"name": "KC_ADMIN_CLIENT_ID", "value": "folio-backend-admin-client", "description": "Keycloak admin client id", "type": "string", "essential": false},
      {"name": "KC_ADMIN_USERNAME", "value": "", "description": "Keycloak admin username", "type": "string", "essential": false},
      {"name": "KC_ADMIN_PASSWORD", "value": "", "description": "Keycloak admin password", "type": "secret", "essential": false},
      {"name": "KC_ADMIN_GRANT_TYPE", "value": "client_credentials", "description": "Keycloak admin grant type", "type": "string", "essential": false},
      {"name": "KC_CLIENT_ID", "value": "mgr-applications", "description": "Keycloak client id", "type": "string", "essential": false},
      {"name": "KC_IMPORT_ENABLED", "value": "false", "description": "Enables Keycloak import", "type": "boolean", "essential": false},
      {"name": "KC_CLIENT_TLS_ENABLED", "value": "false", "description": "Enables TLS for Keycloak client", "type": "boolean", "essential": false},
      {"name": "KC_JWKS_BASE_URL", "value": "", "description": "Keycloak JWKS base URL", "type": "string", "essential": false},
      {"name": "KC_AUTH_TOKEN_VALIDATE_URI", "value": "false", "description": "Validate token URI", "type": "boolean", "essential": false},
      {"name": "KC_JWKS_REFRESH_INTERVAL", "value": "60", "description": "JWKS refresh interval in seconds", "type": "number", "essential": false},
      {"name": "KC_FORCED_JWKS_REFRESH_INTERVAL", "value": "60", "description": "Forced JWKS refresh interval in seconds", "type": "number", "essential": false},
      {"name": "SECRET_STORE_TYPE", "value": "", "description": "Secret store type (AWS_SSM, VAULT, FSSP)", "type": "string", "essential": false},
      {"name": "SECURE_STORE_ENV", "value": "folio", "description": "Secure store environment name", "type": "string", "essential": false},
      {"name": "TE_URL", "value": "http://mgr-tenant-entitlements:8081", "description": "mgr-tenant-entitlements URL", "type": "string", "essential": true},
      {"name": "TE_TLS_ENABLED", "value": "false", "description": "Enables TLS to mgr-tenant-entitlements", "type": "boolean", "essential": false},
      {"name": "MODULE_BOOTSTRAP_CACHE_ENABLED", "value": "true", "description": "Enables module bootstrap cache", "type": "boolean", "essential": false},
      {"name": "MODULE_BOOTSTRAP_CACHE_TTL", "value": "1h", "description": "Module bootstrap cache TTL", "type": "string", "essential": false},
      {"name": "MODULE_BOOTSTRAP_CACHE_MAX_SIZE", "value": "1000", "description": "Module bootstrap cache max size", "type": "number", "essential": false}
    ]
  }
}
