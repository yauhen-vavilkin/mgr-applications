{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "description": "Module",
  "x-implements": [ "org.folio.common.domain.model.Artifact" ],
  "allOf": [
    {
      "$ref": "../common/artifact.json"
    }
  ],
  "properties": {
    "url": {
      "description": "URL to the artifact",
      "type": "string"
    },
    "attributes": {
      "description": "Arbitrary list of key-value pairs (both of type string) with additional information about the module",
      "type": "array",
      "items": {
        "description": "A single attribute entry: string keys mapped to string values",
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
